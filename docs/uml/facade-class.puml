@startuml
class EducationPlatformFacade {
 -users: UserService
 -courses: CourseService
 -quizzes: QuizService
 -grades: GradeService
 -notifications: NotificationService
 -recommendations: RecommendationService
 -decoratedCourses: Map<String, CourseComponent>
 +registerUser(role, name, email): User
 +createCourse(teacherId, configure): Course
 +setInterests(studentId, interests)
 +enroll(studentId, courseId)
 +recommend(studentId, limit)
 +addMaterials(courseId, materials)
 +enableCertificate(courseId)
 +submitQuiz(studentId, courseId, quizTitle, answers): Grade
 +grades(studentId)
 +notifications(studentId)
 +progress(studentId, courseId): CourseProgress
 +requestCertificate(studentId, courseId)
 +markLessonCompleted(studentId, courseId, lessonNumber)
}
class UserService
class CourseService
class QuizService
class GradeService
class NotificationService
class RecommendationService
interface CourseComponent
interface GradeObserver
interface GradeSubject
class StudentNotificationObserver
class Student
EducationPlatformFacade --> UserService
EducationPlatformFacade --> CourseService
EducationPlatformFacade --> QuizService
EducationPlatformFacade --> GradeService
EducationPlatformFacade --> NotificationService
EducationPlatformFacade --> RecommendationService
EducationPlatformFacade o--> CourseComponent : stores decorated course
QuizService --> GradeService : records grade once
GradeService ..|> GradeSubject
GradeService o--> "*" GradeObserver : notifies
StudentNotificationObserver ..|> GradeObserver
StudentNotificationObserver --> Student : delivers notification
NotificationService ..> GradeSubject : subscribe / unsubscribe
UserService ..> UserFactory : creates roles
CourseService ..> Course.Builder : builds course
CourseComponent --> Course
note right of EducationPlatformFacade : Cross-service API; business rules remain in services and domain.
@enduml
