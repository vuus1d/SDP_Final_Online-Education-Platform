@startuml
abstract class User
class Student
class Teacher
class Admin
enum UserRole
class UserFactory {
 {static} +createUser(role, name, email): User
 {static} +createStudent(name, email): Student
 {static} +createTeacher(name, email): Teacher
 {static} +createAdmin(name, email): Admin
}
class UserService
User <|-- Student
User <|-- Teacher
User <|-- Admin
UserFactory ..> UserRole : switches on
UserFactory ..> Student : creates
UserFactory ..> Teacher : creates
UserFactory ..> Admin : creates
UserService ..> UserFactory : calls createUser
@enduml
