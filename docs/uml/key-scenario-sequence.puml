@startuml
actor Presenter
participant ConsoleMenu
participant EducationPlatformFacade as Facade
participant QuizService
participant GradeService
participant StudentNotificationObserver as Observer
participant Student
participant CertificateDecorator
Presenter -> ConsoleMenu : submit quiz answers
ConsoleMenu -> Facade : submitQuiz(student, course, quiz, answers)
Facade -> QuizService : submitQuiz(...)
QuizService -> GradeService : recordGrade(grade)
GradeService -> Observer : onGradePublished(grade)
Observer -> Student : receiveNotification(notification)
QuizService -> QuizService : mark complete only if score >= 70%
QuizService --> Facade : saved Grade
Facade --> ConsoleMenu : grade and pass/fail status
Presenter -> ConsoleMenu : complete lessons, request certificate
ConsoleMenu -> Facade : progress(student, course)
Facade --> ConsoleMenu : progress from lesson positions and passed quizzes
ConsoleMenu -> Facade : requestCertificate(student, course)
Facade -> CertificateDecorator : issueCertificate(student, progress)
CertificateDecorator -> CertificateDecorator : check enrollment, 100%, prior issuance
CertificateDecorator --> Facade : existing/new certificate or empty
Facade --> ConsoleMenu : result
@enduml
