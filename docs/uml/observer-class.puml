@startuml
interface GradeSubject {
 +subscribe(GradeObserver)
 +unsubscribe(GradeObserver)
 +notifyObservers(Grade)
}
interface GradeObserver {
 +onGradePublished(Grade)
}
class GradeService {
 +recordGrade(Grade)
 +getObserverFailures(): List<ObserverFailure>
}
class StudentNotificationObserver {
 -student: Student
 +onGradePublished(Grade)
}
class NotificationService {
 -gradeSubject: GradeSubject
 -observersByStudent: Map<Student, StudentNotificationObserver>
}
class ObserverFailure {
 +grade: Grade
 +observerClass: String
 +cause: RuntimeException
}
class Grade
class Student
GradeSubject <|.. GradeService
GradeObserver <|.. StudentNotificationObserver
GradeService "1" o--> "0..*" GradeObserver : subscribers
GradeService --> "*" Grade : saves
StudentNotificationObserver --> Student : calls receiveNotification
NotificationService --> GradeSubject : manages subscription
NotificationService ..> StudentNotificationObserver : creates per student
GradeService --> ObserverFailure : records callback failures
note right of GradeService
  Commits grade first.
  Isolates runtime observer errors.
  Continues through the subscriber snapshot.
  A saved grade event can be published once.
end note
@enduml
